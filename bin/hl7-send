#!/usr/bin/env ruby
# frozen_string_literal: true

# Minimal MLLP client for trying the gateway by hand.
#
#   bin/hl7-send examples/messages/bmi_request.hl7
#   cat message.hl7 | bin/hl7-send --port 2575 -

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'hl7_gateway'
require 'optparse'
require 'socket'

options = { host: '127.0.0.1', port: Integer(ENV.fetch('HL7_PORT', 2575)), timeout: 10 }
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: hl7-send [options] FILE|-'
  opts.on('--host HOST', 'Gateway host (default 127.0.0.1)') { |value| options[:host] = value }
  opts.on('--port PORT', Integer, 'Gateway port (default $HL7_PORT or 2575)') { |value| options[:port] = value }
  opts.on('--timeout SECONDS', Integer, 'Seconds to wait for the answer (default 10)') { |value| options[:timeout] = value }
  opts.on('-h', '--help') do
    puts opts
    exit
  end
end
parser.parse!

source = ARGV.first
abort parser.to_s unless source

begin
  message = Hl7Gateway::Sanitizer.call(source == '-' ? $stdin.read : File.binread(source))

  Socket.tcp(options[:host], options[:port], connect_timeout: options[:timeout]) do |socket|
    socket.write(Hl7Gateway::MLLP.frame(message))
    stream = Hl7Gateway::MLLP::Stream.new(socket, max_bytes: 10 * 1024 * 1024, idle_timeout: options[:timeout])
    response = stream.read_message
    abort 'No response received (timed out or connection closed)' unless response

    puts response.force_encoding(Encoding::UTF_8).tr("\r", "\n")
  end
rescue SystemCallError, SocketError, Hl7Gateway::Error => e
  abort "hl7-send: #{e.message}"
end
