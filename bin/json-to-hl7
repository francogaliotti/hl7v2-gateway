#!/usr/bin/env ruby
# frozen_string_literal: true

# Converts a JSON document (the format produced by hl7-to-json) back into an HL7 v2 message.
#
#   bin/hl7-to-json message.hl7 | bin/json-to-hl7
#   bin/json-to-hl7 --cr document.json > message.hl7   # real <CR> separators, ready for MLLP

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'hl7_gateway'
require 'json'
require 'optparse'

separator = "\n"
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: json-to-hl7 [--cr] [FILE]'
  opts.version = Hl7Gateway::VERSION
  opts.on('--cr', 'Separate segments with <CR> instead of newlines') { separator = "\r" }
  opts.on('-h', '--help') do
    puts opts
    exit
  end
end
parser.parse!

begin
  input = ARGV.first && ARGV.first != '-' ? File.read(ARGV.first) : $stdin.read
  message = Hl7Gateway::Encoder.call(JSON.parse(input))
  print message.tr("\r", separator)
rescue JSON::ParserError => e
  abort "json-to-hl7: invalid JSON (#{e.message[0, 80]})"
rescue Hl7Gateway::Error, SystemCallError => e
  abort "json-to-hl7: #{e.message}"
end
