# Copy to .env and adjust. Only UPSTREAM_API_URL is required.

# Where converted messages are POSTed as JSON.
UPSTREAM_API_URL=http://localhost:4567/api/messages
# UPSTREAM_API_TOKEN=
# UPSTREAM_API_TIMEOUT=10

# MLLP listener.
HL7_HOST=127.0.0.1
HL7_PORT=2575

# Identity used in MSH-3 / MSH-4 of every response.
HL7_SENDING_APPLICATION=HL7GATEWAY
HL7_SENDING_FACILITY=HL7GATEWAY

# HL7_IDLE_TIMEOUT=60
# HL7_MAX_MESSAGE_BYTES=1048576
LOG_LEVEL=info
